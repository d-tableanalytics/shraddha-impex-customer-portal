{
  "name": "erp-backend",
  "version": "1.0.0",
  "description": "Enterprise ERP Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "verify:box": "node scripts/verify-box-numbers.js",
    "verify:features": "node scripts/verify-feature-pack.js",
    "test": "node --test --experimental-test-module-mocks --test-reporter=spec \"tests/**/*.test.js\"",
    "test:watch": "node --test --experimental-test-module-mocks --watch \"tests/**/*.test.js\"",
    "verify:passwords": "node scripts/verify-password-hashing.js",
    "verify:rbac": "node scripts/verify-rbac.js",
    "verify:contract": "node scripts/verify-shared-contract.js",
    "verify:msil": "node scripts/verify-msil.js",
    "msil:check": "node scripts/sync-msil.js",
    "msil:sync": "node scripts/sync-msil.js --apply",
    "verify:pricing": "node scripts/verify-pricing.js",
    "pricelist": "node scripts/import-pricelist.js",
    "pricelist:apply": "node scripts/import-pricelist.js --apply",
    "report:check": "node scripts/send-inventory-report.js --check",
    "report:dry-run": "node scripts/send-inventory-report.js --dry-run",
    "report:history": "node scripts/send-inventory-report.js --history",
    "report:send": "node scripts/send-inventory-report.js",
    "history:check": "node scripts/send-history-report.js --check",
    "history:dry-run": "node scripts/send-history-report.js --dry-run",
    "history:history": "node scripts/send-history-report.js --history",
    "history:send": "node scripts/send-history-report.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.7.5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
  }
}
